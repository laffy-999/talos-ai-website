# Public, non-secret build configuration. Committed so every build - local, CI, or a
# fresh clone - produces a working booking section without extra dashboard setup.
# NEXT_PUBLIC_* values are inlined into the client bundle at build time and are therefore
# visible in the page source; never put secrets here. Secrets belong in .env.local.

# Google Calendar appointment schedule booking page.
# A pasted /u/<n>/ address-bar link is normalized to the canonical path automatically.
NEXT_PUBLIC_BOOKING_URL=https://calendar.google.com/calendar/appointments/schedules/AcZssZ0VLBZGp4Mi0yuOpTyPjvTZTPbvpTF9sHFifrQlFvHRW_YRRa_UN7g0EXQNwIOPm1ADZqY4deRz

# Cloudflare Web Analytics site token. Public - it appears in page source.
# Create at Cloudflare dashboard > Web Analytics > Add a site, then paste the token here.
# Leave empty to disable analytics; the site works without it.
NEXT_PUBLIC_CF_BEACON_TOKEN=
