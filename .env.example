# Secrets and local overrides belong in .env.local (never committed).
# Public build defaults live in .env (committed).

# Cloudflare deploy credential, required only for `npm run deploy`.
CLOUDFLARE_API_TOKEN=

# Override the committed Google Calendar booking link if needed.
# Must be an https://calendar.google.com/... appointment schedule link.
# NEXT_PUBLIC_BOOKING_URL=

# Cloudflare Web Analytics site token (public, inlined at build time).
# Create at Cloudflare dashboard > Web Analytics > Add a site.
# NEXT_PUBLIC_CF_BEACON_TOKEN=
